# ESM-446 environment template.
# Copy to .env and adjust. Every variable is read through esm446/config/config.py; no
# module calls os.getenv directly. .env is git-ignored and must never be committed.

# --- Application ---
APP_VERSION=0.0.0-dev
ESM446_LOG_LEVEL=INFO

# --- Receiver ---
# SDR_SAMPLE_RATE_HZ must be a rate the device actually supports. The HackRF One operates
# from 2 MS/s upward; v0 requested 800 kS/s, which is below the device minimum, so the
# driver did not deliver what the code assumed.
ESM446_SDR_DRIVER=hackrf
ESM446_SDR_SAMPLE_RATE_HZ=2000000

# Offset-tuned. Two constraints: the centre must sit an exact integer number of 12.5 kHz
# steps from channel 1 so every channel lands on a filter bank bin, AND it must not be a
# nominal channel, because a direct-conversion receiver puts a DC spur at its own centre
# frequency -- measured at +31 dB above the noise floor on a HackRF One. 446593750 is 47
# steps from channel 1 and 400 kHz above channel 16, so the spur and every IQ image fall
# outside the allocation. Both conditions are checked at startup.
ESM446_SDR_CENTRE_FREQ_HZ=446593750

# HackRF internal gains. LNA quantises to 8 dB steps (0-40), VGA to 2 dB steps (0-62).
# These are a budget, not free parameters: with an 8-bit ADC there is roughly 48 dB
# between the noise floor and clipping, so external gain must be taken out of these.
ESM446_SDR_LNA_GAIN_DB=32
ESM446_SDR_VGA_GAIN_DB=20
ESM446_SDR_AMP_ENABLED=false

# Everything ahead of the SDR: external LNA minus cable loss.
ESM446_EXTERNAL_GAIN_DB=20.0

# --- Channeliser ---
# SDR_SAMPLE_RATE_HZ / CHANNELIZER_NUM_CHANNELS must equal the 12.5 kHz PMR446 step, and
# CHANNELIZER_DECIMATION must divide CHANNELIZER_NUM_CHANNELS. Both are checked at startup.
ESM446_CHANNELIZER_NUM_CHANNELS=160
ESM446_CHANNELIZER_DECIMATION=80
ESM446_CHANNELIZER_TAPS_PER_PHASE=12

# --- Detection ---
# Probability of false alarm per bin per frame. Note the unit: with 160 bins at a 25 kHz
# frame rate, four million cells pass through the detector every second, so 1e-4 would mean
# 400 false alarms per second across the band. Tightening to 1e-8 costs 4.3 dB of threshold.
ESM446_CFAR_PFA=1e-8
ESM446_CFAR_METHOD=os

# --- Identification ---
# Pre-shared sub-audible CTCSS tone treated as cooperative identification. Leave unset and
# every emitter is reported UNKNOWN, which is the honest default. This is not IFF.
# ESM446_CTCSS_EXPECTED_TONE_HZ=114.8

# --- Calibration and recording ---
ESM446_CALIBRATION_PATH=config/calibration.yaml

# Audio recording is off by default. The node is metadata-only; read docs/06_legal_ethics.md
# before enabling this, and do not enable it for third-party traffic.
ESM446_RECORD_AUDIO=false
