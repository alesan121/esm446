# --- Secrets: never commit ---
*.key
*.pem
*.crt
.env
config/calibration.local.yaml

# --- Captured / generated signal data ---
*.s16
*.cs16
*.cf32
*.cs8
*.iq
*.wav
*.m4a
!tests/data/**/*.cs16
!tests/data/**/*.cs8

# --- Runtime output ---
out/
*.log
*.jsonl
*.sqlite
*.db

# --- T1: measured results, regenerated by every pytest run, not source ---
# (unlike docs/figures/results.json, which is committed and opt-in via `esm446-vv`)
results/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
